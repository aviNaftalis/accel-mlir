[12.88, "o", "module {\r\n  func.func @reduce(%arg0: f32, %arg1: f32) -> (f32, f32) {\r\n    %0 = arith.addf %arg0, %arg1 : f32\r\n    %1 = arith.addf %arg0, %arg0 : f32\r\n    %2 = arith.addf %1, %arg1 : f32\r\n    return %0, %2 : f32, f32\r\n  }\r\n  func.func @fold_chain() -> f32 {\r\n    %0 = accel.constant 1.000000e+01\r\n    return %0 : f32\r\n  }\r\n  func.func @redundant(%arg0: f32, %arg1: f32, %arg2: f32) -> f32 {\r\n    %0 = accel.mac %arg0, %arg1, %arg2 : f32\r\n    %1 = accel.mac %arg0, %arg1, %arg2 : f32\r\n    %2 = arith.addf %0, %1 : f32\r\n    return %2 : f32\r\n  }\r\n}\r\n\r\n"]
