[8.36, "o", "module {\r\n  func.func @quad(%arg0: f32) -> f32 {\r\n    %cst = arith.constant 5.000000e+00 : f32\r\n    %cst_0 = arith.constant 3.000000e+00 : f32\r\n    %cst_1 = arith.constant 2.000000e+00 : f32\r\n    %0 = arith.mulf %arg0, %cst_1 : f32\r\n    %1 = arith.mulf %arg0, %cst_0 : f32\r\n    %2 = accel.mac %0, %arg0, %1 : f32\r\n    %3 = arith.addf %2, %cst : f32\r\n    return %3 : f32\r\n  }\r\n}\r\n\r\n"]
