[3.54, "o", "// generated by aclc from quadratic.acl\r\nfunc.func @quad(%x: f32) -> f32 {\r\n  %0 = arith.constant 2.000000e+00 : f32\r\n  %1 = arith.mulf %0, %x : f32\r\n  %2 = arith.mulf %1, %x : f32\r\n  %3 = arith.constant 3.000000e+00 : f32\r\n  %4 = arith.mulf %3, %x : f32\r\n  %5 = arith.addf %2, %4 : f32\r\n  %6 = arith.constant 5.000000e+00 : f32\r\n  %7 = arith.addf %5, %6 : f32\r\n  return %7 : f32\r\n}\r\n"]
