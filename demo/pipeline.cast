[19.7, "o", "module {\r\n  llvm.func @compute(%arg0: f32, %arg1: f32, %arg2: f32) -> f32 {\r\n    %0 = llvm.fmul %arg0, %arg1 : f32\r\n    %1 = llvm.fadd %0, %arg2 : f32\r\n    llvm.return %1 : f32\r\n  }\r\n}\r\n\r\n"]
