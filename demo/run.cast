[15.16, "o", "\r\naccel-mlir dot product vs clang -O2 -march=native (strict C)\r\n  accel kernel uses 10 packed-FMA (vfmadd*p[sd]) instructions; baseline is scalar serial\r\n\r\n        n     baseline        accel   speedup   accuracy (rel.err)\r\n               GFLOP/s      GFLOP/s             base / accel\r\n      512         1.07        18.77     17.5x   5.3e-07 / 3.2e-08\r\n     1024         1.07        21.46     20.1x   2.2e-07 / 5.8e-08\r\n     2048         1.22        22.94     18.8x   3.0e-07 / 1.7e-08\r\n     4096         1.30        27.39     21.1x   3.0e-07 / 7.7e-08\r\n     8192         1.22        17.03     14.0x   1.8e-06 / 3.2e-08\r\n    16384         1.26        13.47     10.7x   1.2e-05 / 2.5e-07\r\n    32768         1.25        11.92      9.5x   1.1e-05 / 1.7e-07\r\n\r\n  peak speedup: 21.1x (compute-bound, L1-resident)\r\n\r\nwrote /home/avin/accel-mlir/demo/benchmark_dot.png\r\n"]
